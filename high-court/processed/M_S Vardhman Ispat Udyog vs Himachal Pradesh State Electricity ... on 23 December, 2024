.date-clear-btn:hover { background-color: var(--form-bg-tertiary); border-color: var(--form-border-hover); color: var(--form-text-secondary); }

.date-range-inputs { display: grid; grid-template-columns: 1fr; gap: var(--spacing-md); }

.date-input-card { display: flex; flex-direction: column; gap: var(--spacing-sm); padding: var(--spacing-md); background: var(--form-bg-secondary); border-radius: var(--radius-md); border: 1px solid var(--form-border-color); }

.date-chip { font-size: 0.8rem; font-weight: 600; color: var(--form-text-secondary); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: var(--spacing-xs); }

.date-input-group { display: flex; align-items: center; gap: var(--spacing-sm); position: relative; }

.date-input-icon { width: 16px; height: 16px; color: var(--form-text-muted); flex-shrink: 0; position: absolute; left: var(--spacing-md); z-index: 1; }

.date-input { flex: 1 1 0%; padding: var(--spacing-md) var(--spacing-md) var(--spacing-md) 44px; border: 1px solid var(--form-border-color); border-radius: var(--radius-md); font-size: 1rem; font-family: var(--form-font-family); background: var(--form-bg-primary); color: var(--form-text-primary); transition: var(--form-transition); width: 100%; box-sizing: border-box; }

.date-input:focus { outline: none; border-color: var(--form-border-focus); box-shadow: var(--form-focus-ring); }

.date-input::placeholder { color: var(--form-text-hint); opacity: 1; }

.date-input:hover { border-color: var(--form-border-hover); }

.date-picker-trigger { display: inline-flex; align-items: center; gap: var(--spacing-xs); padding: var(--spacing-xs) var(--spacing-sm); background: var(--form-bg-tertiary); border: 1px solid var(--form-border-color); border-radius: var(--radius-sm); color: var(--form-text-secondary); font-size: 0.8rem; font-family: var(--form-font-family); cursor: pointer; transition: var(--form-transition); white-space: nowrap; }

.date-picker-trigger:hover { background-color: var(--form-bg-secondary); border-color: var(--form-border-hover); }

.date-picker-trigger-icon { width: 12px; height: 12px; }

.date-range-hint { font-size: 0.8rem; color: var(--form-text-hint); margin-top: var(--spacing-sm); line-height: 1.4; white-space: normal; font-family: var(--form-font-family); }

.form-actions { display: flex; flex-direction: row; gap: var(--spacing-md); margin-top: var(--spacing-lg); margin-left: 0px; padding-left: 0px; align-items: flex-start; justify-content: flex-start; }

.form-layout > .form-actions { grid-column: 1 / -1; }

.btn { display: inline-flex; align-items: center; justify-content: center; gap: var(--spacing-sm); padding: 10px 18px; border-radius: var(--radius-md); font-size: 0.95rem; font-family: var(--form-font-family); font-weight: 500; text-decoration: none; cursor: pointer; transition: var(--form-transition); border: 1px solid; min-height: 40px; line-height: 1; box-sizing: border-box; flex: 0 0 auto; }

.form-actions .btn { width: auto; flex: 0 0 auto; }

.btn-icon { width: 18px; height: 18px; flex-shrink: 0; display: block; }

.btn-primary { background: rgb(59, 130, 246); color: white; border-color: rgb(59, 130, 246); }

.btn-primary:hover { background: rgb(37, 99, 235); border-color: rgb(37, 99, 235); }

.btn-secondary { background: var(--form-bg-primary); color: var(--form-text-secondary); border-color: var(--form-border-hover); }

.btn-secondary:hover { background: var(--form-bg-tertiary); color: var(--form-text-secondary); border-color: var(--form-border-hover); }

.document-types-section { margin-top: var(--spacing-lg); padding: 0 var(--spacing-card-top) var(--spacing-card-top); }

.doc-types-container { display: flex; flex-direction: column; gap: var(--spacing-lg); max-height: clamp(280px, 50vh, 420px); overflow-y: auto; padding-right: var(--spacing-sm); }

.doc-category { background: var(--form-bg-primary); border: 1px solid var(--form-border-color); border-radius: var(--radius-table); box-shadow: var(--form-shadow-sm); transition: var(--form-transition); }

.doc-category:hover { box-shadow: var(--form-shadow-md); }

.doc-category-header { display: flex; align-items: center; justify-content: space-between; gap: var(--spacing-xs); padding: var(--spacing-xs) var(--spacing-md); background: var(--form-bg-secondary); border-bottom: 1px solid var(--form-border-color); }

.doc-category-title { font-size: 1rem; font-weight: 600; color: var(--form-text-secondary); margin: 0px; font-family: var(--form-font-family); }

.doc-category-header .btn-sm { padding: var(--spacing-xs) var(--spacing-sm); min-height: 0px; }

.doc-options-grid { display: grid; grid-template-columns: minmax(0px, 1fr); gap: var(--spacing-sm); padding: var(--spacing-md); width: 100%; }

@media (min-width: 520px) {
  .doc-options-grid { grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); }
}

.doc-option { display: flex; align-items: center; gap: var(--spacing-xs); padding: var(--spacing-sm); border-radius: var(--radius-sm); transition: var(--form-transition); cursor: pointer; min-height: 40px; box-sizing: border-box; border: 1px solid transparent; }

.doc-option:hover { background: var(--form-bg-tertiary); border-color: var(--form-border-hover); }

.doc-checkbox { margin: 0px; flex-shrink: 0; accent-color: var(--form-border-focus); }

.doc-option-text { font-size: 0.9rem; color: var(--form-text-secondary); line-height: 1.4; font-family: var(--form-font-family); overflow-wrap: break-word; user-select: none; }

.btn-sm { padding: var(--spacing-xs) var(--spacing-sm); font-size: 0.8rem; min-height: 32px; font-family: var(--form-font-family); }

.btn-outline { background-color: transparent; color: rgb(59, 130, 246); border-color: rgb(59, 130, 246); }

.btn-outline:hover { background-color: rgba(59, 130, 246, 0.08); color: rgb(59, 130, 246); border-color: rgb(59, 130, 246); }

@media (max-width: 480px) {
