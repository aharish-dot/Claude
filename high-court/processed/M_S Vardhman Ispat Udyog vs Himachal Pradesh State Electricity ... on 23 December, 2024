.premium-features-header h2 { font-size: 1.6rem; font-weight: 700; color: rgb(51, 51, 51); margin-bottom: 0.25rem; }

.premium-features-subtitle { font-size: 0.95rem; color: rgb(85, 85, 85); line-height: 1.5; font-weight: 400; }

