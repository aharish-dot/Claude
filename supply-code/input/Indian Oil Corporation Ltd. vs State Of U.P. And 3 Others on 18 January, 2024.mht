.citetextbutton:focus-visible { outline: rgba(0, 123, 255, 0.7) solid 2px; outline-offset: 3px; box-shadow: rgba(0, 0, 0, 0.1) 0px 2px 4px, rgba(0, 123, 255, 0.2) 0px 0px 0px 3px; }

.citetextbutton::before { background-color: rgb(255, 255, 255); }

.citetextbutton:hover::before { background-color: rgb(245, 245, 245); }

.citetextbutton[data-selected="true"]::before { background-color: inherit; }

.citetextbutton[data-selected="true"]:hover::before { background-color: inherit; }

.citetextbutton[data-selected="true"] { border-color: currentcolor; border-width: 3px; box-shadow: rgba(0, 0, 0, 0.2) 0px 4px 10px, rgba(255, 255, 255, 0.25) 0px 1px 0px inset; }

.citetextbutton[data-selected="true"]::after { content: ""; position: absolute; inset: -4px; border-radius: 10px; border: 2px solid rgba(0, 0, 0, 0.08); pointer-events: none; opacity: 0.9; }

#citeselect-button { display: inline-block; margin: 0px auto; min-width: 200px; border-radius: 6px; box-shadow: rgba(0, 0, 0, 0.1) 0px 2px 4px; transition: 0.2s; }

#citeselect-button:hover { box-shadow: rgba(0, 0, 0, 0.15) 0px 4px 8px; transform: translateY(-1px); }

#citeselect-button:active { transform: translateY(0px); box-shadow: rgba(0, 0, 0, 0.1) 0px 2px 4px; }

#citeselect-button .ui-selectmenu-text { font-weight: 500; color: rgb(33, 150, 243); }
