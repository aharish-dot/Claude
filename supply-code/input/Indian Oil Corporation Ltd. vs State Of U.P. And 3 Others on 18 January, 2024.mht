.video-features-grid > :only-child { grid-column: 1 / -1; justify-self: center; max-width: 640px; width: 100%; }

.video-feature-item { display: flex; flex-direction: column; background: linear-gradient(145deg, rgb(255, 255, 255), rgb(248, 249, 250)); border-radius: 16px; overflow: hidden; box-shadow: rgba(0, 0, 0, 0.1) 0px 10px 30px, rgba(0, 0, 0, 0.06) 0px 1px 8px; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); border: 1px solid rgba(255, 255, 255, 0.2); position: relative; }

.court-copy-item { text-align: center; }

.court-copy-item .video-feature-content { align-items: center; }

.video-feature-item::before { content: ""; position: absolute; top: 0px; left: 0px; right: 0px; height: 2px; background: var(--color-primary); opacity: 0; transition: opacity 0.3s; }

.video-feature-item:hover::before { opacity: 1; }

.video-feature-item:hover { transform: translateY(-8px); box-shadow: rgba(0, 0, 0, 0.15) 0px 20px 40px, rgba(0, 0, 0, 0.1) 0px 4px 12px; }

.video-feature-item video { width: 100%; height: 220px; object-fit: contain; margin: 0px; display: block; transition: transform 0.3s; background: rgb(0, 0, 0); }

.video-feature-item:hover video { transform: scale(1.05); }

.video-feature-content { padding: 2rem; flex: 1 1 0%; display: flex; flex-direction: column; }

.video-feature-title { font-size: 1.3rem; font-weight: 600; color: var(--color-text); margin-bottom: 1rem; line-height: 1.3; }

.video-feature-description { font-size: 0.95rem; line-height: 1.6; color: var(--color-text-muted); flex: 1 1 0%; }

.video-feature-description p { margin: 0px; }

.banner-video { width: 100%; margin: 2rem 0px 3rem; border-radius: 16px; box-shadow: rgba(0, 0, 0, 0.15) 0px 20px 40px; overflow: hidden; background: linear-gradient(45deg, rgb(245, 245, 245), rgb(224, 224, 224)); }

.prism-section { margin-top: 4rem; }

.prism-hero { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2.5rem; padding: 3rem; border-radius: 28px; background: linear-gradient(120deg, rgb(255, 247, 237) 0%, rgb(243, 242, 255) 55%, rgb(238, 248, 255) 100%); border: 1px solid rgba(15, 23, 42, 0.08); box-shadow: rgba(15, 23, 42, 0.15) 0px 35px 80px; position: relative; }

.prism-eyebrow { text-transform: uppercase; letter-spacing: 0.2em; font-size: 0.85rem; color: var(--color-primary); margin-bottom: 0.75rem; display: inline-block; }

.prism-hero-copy .section-title { text-align: left; margin: 0px 0px 1rem; }

.prism-hero-copy .section-title::after { margin: 1rem 0px 0px; background: rgba(15, 23, 42, 0.3); }

.prism-hero-description { font-size: 1.05rem; line-height: 1.7; color: rgba(15, 23, 42, 0.8); max-width: 46ch; }

.prism-hero-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }

.prism-btn { display: inline-flex; align-items: center; justify-content: center; padding: 0.85rem 1.75rem; border-radius: 999px; font-weight: 600; text-decoration: none; border: 1px solid transparent; background: var(--color-primary); color: rgb(255, 255, 255); transition: transform 0.2s, box-shadow 0.2s; }

.prism-btn:hover { transform: translateY(-1px); box-shadow: rgba(0, 0, 0, 0.12) 0px 12px 30px; }

.prism-btn--ghost { background: transparent; color: var(--color-primary); border-color: rgba(15, 23, 42, 0.2); backdrop-filter: blur(6px); }

.prism-hero-media { width: 100%; position: relative; }

.prism-hero-video { width: 100%; border-radius: 20px; border: 1px solid rgba(15, 23, 42, 0.1); box-shadow: rgba(15, 23, 42, 0.25) 0px 30px 70px; }

.prism-tools-grid { margin-top: 3rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.75rem; }

.prism-tool-card { background: rgb(255, 255, 255); border-radius: 20px; border: 1px solid rgba(15, 23, 42, 0.06); box-shadow: rgba(15, 23, 42, 0.08) 0px 18px 40px; overflow: hidden; display: flex; flex-direction: column; transition: transform 0.2s, box-shadow 0.2s; }

.prism-tool-card:hover { transform: translateY(-4px); box-shadow: rgba(15, 23, 42, 0.12) 0px 30px 70px; }

.prism-tool-media video { width: 100%; height: 220px; object-fit: contain; border: 0px; background: rgb(0, 0, 0); }

.prism-tool-body { padding: 1.75rem; display: flex; flex-direction: column; gap: 0.85rem; }

.prism-tool-body h4 { margin: 0px; font-size: 1.15rem; font-weight: 600; color: var(--color-text); }

.prism-tool-body p { margin: 0px; color: var(--color-text-muted); line-height: 1.6; }

.features-section { margin: 4rem 0px; }

.features-section .section-title { font-size: 2rem; font-weight: 600; color: var(--color-text); margin: 3rem 0px 2rem; text-align: center; position: relative; }

.features-section .section-title::after { content: ""; display: block; width: 32px; height: 1px; background: var(--color-primary); margin: 1.2rem auto 0px; opacity: 0.8; }

@media (max-width: 1200px) {
  .video-features-grid { gap: 2rem; }
  .video-feature-content { padding: 1.5rem; }
}

@media (max-width: 1024px) {
  .video-features-grid { grid-template-columns: 1fr; gap: 2rem; max-width: 800px; margin: 2rem auto; }
  .video-feature-item video { height: 280px; }
  .prism-hero { padding: 2.25rem; border-radius: 22px; }
  .prism-tool-media video { height: 200px; }
  .premium-features-header h2 { font-size: 2.2rem; }
}

@media (max-width: 768px) {
  .video-feature-item video { height: 240px; }
  .video-feature-content { padding: 1.5rem; }
  .premium-features-header h2 { font-size: 2rem; }
  .premium-features-subtitle { font-size: 1.1rem; }
  .prism-hero { padding: 2rem; gap: 1.75rem; }
  .prism-hero-cta { flex-direction: column; align-items: stretch; }
  .prism-tool-media video { height: 180px; }
  .features-section { margin: 3rem 0px; }
}

@media (max-width: 480px) {
  .video-feature-item video { height: 200px; }
  .video-feature-content { padding: 1rem; }
  .video-feature-title { font-size: 1.1rem; }
  .premium-features-header h2 { font-size: 1.8rem; }
  .video-features-grid { gap: 1.5rem; }
  .prism-hero { padding: 1.5rem; }
  .prism-tool-media video { height: 160px; }
}

.sr-only { position: absolute; width: 1px; height: 1px; padding: 0px; margin: -1px; overflow: hidden; clip: rect(0px, 0px, 0px, 0px); white-space: nowrap; border: 0px; }

.skip-link { position: absolute; top: -100px; left: 0px; background: rgb(0, 0, 0); color: rgb(255, 255, 255); padding: 8px 16px; z-index: 10000; text-decoration: none; }

.skip-link:focus { top: 0px; }

.sr-only-list { list-style: none; padding: 0px; margin: 0px; }

.sr-only-list li { margin: 0px; padding: 0px; }
