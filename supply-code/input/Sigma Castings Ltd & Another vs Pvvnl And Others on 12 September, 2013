.footer-btn--draft:hover:not(:disabled) span { display: none; }

.footer-btn--draft:hover:not(:disabled)::after { content: attr(data-hover-text); color: white; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.01em; }

.footer-btn--kyk:hover:not(:disabled) span { display: none; }

.footer-btn--kyk:hover:not(:disabled)::after { content: attr(data-hover-text); color: rgb(154, 52, 18); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.01em; }

