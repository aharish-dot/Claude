value": "2009", "formInput": "electricity%20%22section%20127%22%20appeal%20pre-deposit%20%20doctypes%3A%20highcourts+year:2009"}, {"value": "2013", "formInput": "electricity%20%22section%20127%22%20appeal%20pre-deposit%20%20doctypes%3A%20highcourts+year:2013"}, {"value": "2015", "formInput": "electricity%20%22section%20127%22%20appeal%20pre-deposit%20%20doctypes%3A%20highcourts+year:2015"}]]], "docs": [{"tid": 62007055, "catids": null, "doctype": 1006, "publishdate": "2025-03-18", "authorid": null, "bench": null, "title": "Gour Kishor Mondal vs The Wbsedcl & Ors on 18 March, 2025", "numcites": 4, "numcitedby": 0, "headline": "<b>appeal</b> without the\n\n<b>pre</b>-<b>deposit</b> as per  <b>Section</b> <b>127</b>  of the <b>Electricity</b> Act,\n\n2003. It is further contended that <b>pre</b>-<b>deposit</b> is a\n\nmandatory requisite ... that the petitioner had filed the\n\n<b>appeal</b> without the requisite <b>pre</b>-<b>deposit</b>. Under\n\n <b>Section</b> <b>127</b>(2)  of the <b>Electricity</b> Act, 2003 no <b>appeal</b>\n\nshall", "docsize": 4939, "fragment": true, "docsource": "Calcutta High Court (Appellete Side)"}, {"tid": 66281227, "catids": null, "doctype": 1024, "publishdate": "2024-11-20", "authorid": null, "bench": null, "title": "Reliance Eminent Trading And ... vs Punjab State Power Corp. Ltd. And Anr on 20 November, 2024", "numcites": 19, "numcitedby": 0, "headline": "Unauthorized\n\nUse of <b>Electricity</b> was issued by the Superintendent Engineer vide memo\n\nNo.19221 dated 20.10.2023 calling upon the petitioner to <b>deposit</b> an amount ... <b>appeal</b> before the\n\nAppellate Authority under  <b>Section</b> <b>127</b>  of the <b>Electricity</b> Act, 2003 by making a\n\n<b>pre</b>-<b>deposit</b> of 50% to tune", "docsize": 42180, "fragment": true, "docsource": "Punjab-Haryana High Court"}, {"tid": 198541357, "catids": null, "doctype": 1031, "publishdate": "2025-11-27", "authorid": 1790, "bench": [1790], "title": "Welfare Association Of Rain Tree Park vs Southern Power Distribution Company Of ... on 27 November, 2025", "numcites": 4, "numcitedby": 0, "headline": "lies in filing an <b>Appeal</b>\n\nunder  <b>Section</b> <b>127</b>  of the <b>Electricity</b> Act, 2003, which mandates\n\na <b>pre</b>-<b>deposit</b> of 50% of the assessed amount ... <b>Electricity</b> Act, 2003, provides an appellate remedy to any\n\nconsumer aggrieved by a final assessment under  <b>Section</b> 126 .\n\nSuch <b>appeal</b> is conditional upon <b>pre</b>-<b>deposit</b>", "docsize": 17678, "fragment": true, "docsource": "Telangana High Court", "author": "N Bheemapaka", "authorEncoded": "n-bheemapaka"}, {"tid": 68476878, "catids": null, "doctype": 1007, "publishdate": "2024-02-06", "authorid": 1303, "bench": [1303], "title": "S.Perumal vs The Chairman on 6 February, 2024", "numcites": 3, "numcitedby": 0, "headline": "<b>appeal</b> under  <b>Section</b> <b>127</b>  of the Act\n                and such <b>appeal</b>, if filed within a period of two (2) weeks from today along with\n                <b>pre</b>-<b>deposit</b> ... under  <b>Section</b> <b>127</b>  of the <b>Electricity</b> Act\n\n                within a period of two (2) weeks from 31.01.2024, ie., on or before 14.02.2024\n\n                with <b>pre</b>-<b>deposit</b>", "docsize": 10345, "fragment": true, "docsource": "Madras High Court", "author": "A Sumanth", "authorEncoded": "a-sumanth"}, {"tid": 178639464, "catids": [32, 1], "doctype": 1013, "publishdate": "2015-02-26", "authorid": 1101, "bench": [1101], "title": "P.A.Beefathu vs Kerala State <b>Electricity</b> Board on 26 February, 2015", "numcites": 3, "numcitedby": 0, "headline": "mandate of\n\n<b>pre</b>-<b>deposit</b> under Sub <b>Section</b> (2) of  <b>Section</b> <b>127</b>  of the\n\n<b>Electricity</b> Act, 2003,      the appellate authority shall\n\nentertain the <b>appeal</b> and disposed ... credit of while fixing the amount         payable towards\n\n<b>pre</b>-<b>deposit</b>, under Subsection (2) of  <b>Section</b> <b>127</b>  of the\n\nAct.\n \n       11. Taking into consideration the fact", "docsize": 12572, "fragment": true, "docsource": "Kerala High Court", "author": "A Narendran", "authorEncoded": "a-narendran"}, {"tid": 54460326, "catids": null, "doctype": 1015, "publishdate": "2023-10-16", "authorid": 1448, "bench": [1448], "title": "Gopal Chandra Pradhan vs Tpcodl on 16 October, 2023", "numcites": 1, "numcitedby": 0, "headline": "position to\n            pay requisite <b>pre</b>-<b>deposit</b> for filing of an <b>appeal</b> under  <b>Section</b>\n            <b>127</b>  of the <b>Electricity</b> Act, 2003 (for short", "docsize": 5347, "fragment": true, "docsource": "Orissa High Court", "author": "K R Mohapatra", "authorEncoded": "k-r-mohapatra"}, {"tid": 28164474, "catids": null, "doctype": 1013, "publishdate": "2021-03-05", "authorid": 1826, "bench": [1826], "title": "E.Joseph Simon vs Kerala State <b>Electricity</b> Board Ltd on 5 March, 2021", "numcites": 2, "numcitedby": 0, "headline": "that requirement of <b>pre</b>-<b>deposit</b> of\n\n50% of the final assessment is a statutory requirement prescribed by\n\n <b>Section</b> <b>127</b>  of the <b>Electricity</b> Act and that ... <b>Section</b> 126  of\n\nthe <b>Electricity</b> Act can prefer the <b>appeal</b> in the prescribed form and\n\nthat <b>appeal</b> has to be accompanied by <b>pre</b>-<b>deposit</b>", "docsize": 7640, "fragment": true, "docsource": "Kerala High Court", "author": "A M Badar", "authorEncoded": "a-m-badar"}, {"tid": 189773038, "catids": null, "doctype": 1013, "publishdate": "2017-11-24", "authorid": 1161, "bench": [1161], "title": "Unknown vs By Advs.Sri.Siraj Karoly on 24 November, 2017", "numcites": 2, "numcitedby": 0, "headline": "<b>Section</b> <b>127</b>  of the <b>Electricity</b> Act against the bills in the\n\nnature of Ext.P3, the petitioner can file <b>appeal</b> only on <b>deposit</b> ... cases, this Court permitted <b>appeals</b> to be filed without\n\nthe <b>pre</b>-<b>deposit</b> provided for under  <b>Section</b> <b>127</b>  of the <b>Electricity</b>\n\f\n WPC No.1079", "docsize": 5262, "fragment": true, "docsource": "Kerala High Court", "author": "P B Kumar", "authorEncoded": "p-b-kumar"}, {"tid": 144680781, "catids": null, "doctype": 1013, "publishdate": "2014-02-01", "authorid": 1165, "bench": [1165], "title": "S.Vijayan vs The Deputy Chief Engineer(Appellate ... on 1 February, 2014", "numcites": 1, "numcitedby": 0, "headline": "BOARD,\n            <b>ELECTRICAL</b> RURAL CIRCLE,\n            THIRUVANANTHAPURAM - 695 772.\n\n        2. THE ASSISTANT ENGINEER,\n            <b>ELECTRICAL</b> <b>SECTION</b>, PUTHENCHANTHA,\n            THIRUVANANTHAPURAM - 695 001.\n\n\n             BY SRI.JAICE JACOB,SC\n\n\n            THIS WRIT PETITION ... <b>appeal</b> under  <b>Section</b> <b>127</b>  of the\n\n<b>Electricity</b> Act, 2003, satisfying the statutory <b>pre</b>-<b>deposit</b> of 50%.\n\nThe learned counsel submits that, the prayer is only", "docsize": 4918, "fragment": true, "docsource": "Kerala High Court", "author": "P R Menon", "authorEncoded": "p-r-menon"}, {"tid": 7581019, "catids": null, "doctype": 1011, "publishdate": "2022-12-20", "authorid": 783, "bench": [783], "title": "Page No.# 1/3 vs The Appellate Authority And 5 Ors on 20 December, 2022", "numcites": 1, "numcitedby": 0, "headline": "VERSUS\n\n          THE APPELLATE AUTHORITY AND 5 ORS\n          APPOINTED U/S <b>127</b> OF THE <b>ELECTRICITY</b> ACT, 2003, BILUJI BHAWAN,\n          GHY-01\n\n          2:THE ASSAM POWER DISTRIBUTION ... instructions on the amount of <b>pre</b>-<b>deposit</b>, which is\nrequired for entertaining an <b>appeal</b> under  <b>Section</b> <b>127</b>  of the <b>Electricity</b> Act, 2003.\n       List again", "docsize": 3476, "fragment": true, "docsource": "Gauhati High Court", "author": "S K Medhi", "authorEncoded": "s-k-medhi"}], "found": "1 - 10 of 116", "encodedformInput": "electricity%20%22section%20127%22%20appeal%20pre-deposit%20doctypes%3Ahighcourts"}