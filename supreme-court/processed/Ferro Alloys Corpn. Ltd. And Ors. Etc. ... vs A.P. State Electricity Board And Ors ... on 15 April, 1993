.homepage-footer { background: rgb(247, 247, 247); padding: 18px 0px; border-top: 1px solid rgb(224, 224, 224); margin-top: 40px; }

.homepage-footer-links { display: flex; justify-content: center; align-items: center; gap: 16px; margin: 0px auto; padding: 0px 16px; font-size: 0.85em; max-width: 900px; flex-wrap: wrap; overflow-x: auto; white-space: nowrap; }

.homepage-footer-links a { color: rgb(0, 90, 153); font-weight: 500; text-decoration: none; white-space: nowrap; }

.homepage-footer-links a:hover { text-decoration: underline; }

.homepage-footer .device-toggle { margin: 0px; visibility: visible; display: inline-block !important; }

.device-toggle button { background: transparent; border: 1px solid rgb(0, 90, 153); color: rgb(0, 90, 153); padding: 4px 12px; border-radius: 4px; font-size: 0.85em; font-weight: 500; cursor: pointer; white-space: nowrap; transition: 0.2s; }

.device-toggle button:hover { background: rgb(0, 90, 153); color: white; }

.device-toggle button:active { transform: translateY(1px); }

.api-footer .homepage-footer { margin-top: 40px; }

@media (min-width: 768px) {
  .homepage-footer-links { padding: 0px 24px; font-size: 0.9em; }
}

@media (max-width: 420px) {
  .homepage-footer-links { gap: 12px; }
  .device-toggle button { font-size: 0.8em; padding: 3px 10px; }
}
