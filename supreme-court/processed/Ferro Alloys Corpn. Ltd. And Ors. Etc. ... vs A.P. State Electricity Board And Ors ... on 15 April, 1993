.premium-features-header::before { content: ""; position: absolute; inset: 0px; background: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.08'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E"); }

.premium-features-header * { position: relative; z-index: 1; }

.premium-features-header h2 { font-size: 1.6rem; font-weight: 700; color: rgb(51, 51, 51); margin-bottom: 0.25rem; }

.premium-features-subtitle { font-size: 0.95rem; color: rgb(85, 85, 85); line-height: 1.5; font-weight: 400; }

.video-features-grid { display: flex; flex-direction: column; gap: 1.5rem; margin: 2rem 0px; width: 100%; }

.video-feature-item { display: flex; flex-direction: column; background: linear-gradient(145deg, rgb(255, 255, 255), rgb(248, 249, 250)); border-radius: 12px; overflow: hidden; box-shadow: rgba(0, 0, 0, 0.12) 0px 8px 24px; transition: 0.3s; border: 1px solid rgba(255, 255, 255, 0.2); }

.court-copy-item { text-align: center; }

.court-copy-item .video-feature-content { align-items: center; }

.video-feature-item video { width: 100%; height: 200px; object-fit: contain; margin: 0px; display: block; transition: transform 0.3s; background: rgb(0, 0, 0); }

.video-feature-content { padding: 1.5rem; flex: 1 1 0%; display: flex; flex-direction: column; }

.video-feature-title { font-size: 1.1rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.8rem; line-height: 1.3; }

.video-feature-description { font-size: 0.9rem; line-height: 1.5; color: var(--color-text-muted); flex: 1 1 0%; }

.video-feature-description p { margin: 0px; }

.banner-video { width: 100%; margin: 1.5rem 0px 2rem; border-radius: 12px; box-shadow: rgba(0, 0, 0, 0.15) 0px 8px 24px; overflow: hidden; background: linear-gradient(45deg, rgb(245, 245, 245), rgb(224, 224, 224)); }

.prism-section { margin-top: 3rem; }

.prism-hero { display: flex; flex-direction: column; gap: 1.5rem; padding: 1.75rem; border-radius: 22px; background: linear-gradient(135deg, rgb(255, 247, 237) 0%, rgb(245, 243, 255) 60%, rgb(238, 248, 255) 100%); border: 1px solid rgba(0, 0, 0, 0.06); box-shadow: rgba(0, 0, 0, 0.12) 0px 18px 36px; }

.prism-eyebrow { text-transform: uppercase; letter-spacing: 0.18em; font-size: 0.75rem; color: var(--color-primary); margin-bottom: 0.6rem; display: inline-block; }

.prism-hero-copy .section-title { text-align: left; margin: 0px 0px 1rem; }

.prism-hero-copy .section-title::after { margin: 1rem 0px 0px; }

.prism-hero-description { font-size: 0.95rem; line-height: 1.6; color: rgba(0, 0, 0, 0.75); }

.prism-hero-cta { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem; }

.prism-btn { display: inline-flex; align-items: center; justify-content: center; padding: 0.85rem 1.25rem; border-radius: 999px; font-weight: 600; text-decoration: none; border: 1px solid transparent; background: var(--color-primary); color: rgb(255, 255, 255); }

.prism-btn--ghost { background: transparent; color: var(--color-primary); border-color: rgba(0, 0, 0, 0.2); }

.prism-hero-video { width: 100%; border-radius: 16px; border: 1px solid rgba(0, 0, 0, 0.08); box-shadow: rgba(0, 0, 0, 0.18) 0px 20px 40px; }

.prism-tools-grid { margin-top: 2.25rem; display: flex; flex-direction: column; gap: 1.25rem; }

.prism-tool-card { background: rgb(255, 255, 255); border-radius: 18px; overflow: hidden; border: 1px solid rgba(0, 0, 0, 0.05); box-shadow: rgba(0, 0, 0, 0.08) 0px 15px 30px; }

.prism-tool-media video { width: 100%; height: 200px; object-fit: contain; background: rgb(0, 0, 0); }

.prism-tool-body { padding: 1.5rem; }

.prism-tool-body h4 { margin: 0px 0px 0.75rem; font-size: 1.05rem; font-weight: 600; color: var(--color-text); }

.prism-tool-body p { margin: 0px; color: var(--color-text-muted); line-height: 1.55; }

.features-section { margin: 3rem 0px; }

.features-section .section-title { font-size: 1.6rem; font-weight: 600; color: var(--color-text); margin: 2rem 0px 1.5rem; text-align: center; position: relative; }

.features-section .section-title::after { content: ""; display: block; width: 28px; height: 1px; background: var(--color-primary); margin: 1rem auto 0px; opacity: 0.8; }

@media (max-width: 400px) {
  #structuralanal table, #structuralanal tbody, #structuralanal tr.butset, #citetextdash table, #citetextdash tbody, #citetextdash tr.butset { display: block; width: 100%; }
  #structuralanal table tr.butset td, #citetextdash table tr.butset td { display: block; width: 100%; margin-bottom: 8px; box-sizing: border-box; }
}

.sr-only { position: absolute; width: 1px; height: 1px; padding: 0px; margin: -1px; overflow: hidden; clip: rect(0px, 0px, 0px, 0px); white-space: nowrap; border: 0px; }

.skip-link { position: absolute; top: -100px; left: 0px; background: rgb(0, 0, 0); color: rgb(255, 255, 255); padding: 8px 16px; z-index: 10000; text-decoration: none; }

.skip-link:focus { top: 0px; }

.sr-only-list { list-style: none; padding: 0px; margin: 0px; }

.sr-only-list li { margin: 0px; padding: 0px; }

.keyboard-focus, button.keyboard-focus, a.keyboard-focus { outline: rgb(74, 144, 226) solid 3px !important; outline-offset: 2px !important; }

.section_header.keyboard-focus { background-color: rgb(240, 240, 240); }

button.section_header { width: 100%; text-align: left; background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; padding: 10px; }

button.section_header:hover { background-color: rgb(245, 245, 245); }

@media (prefers-contrast: high) {
  .keyboard-focus { outline: rgb(0, 0, 0) solid 4px !important; }
}

#structural_header, #citetext_header, #tags_queries_header, #research_notes_header { font-weight: bold; font-size: 0.8em; }
